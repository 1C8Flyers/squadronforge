generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  systemAdmin
  user
}

enum TenantRole {
  tenantAdmin
  tenantViewer
}

enum SyncRunStatus {
  success
  failed
  running
}

enum MemberType {
  CADET
  SENIOR
  UNKNOWN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum EventVisibility {
  tenant
  audience
}

enum RsvpStatus {
  yes
  no
  maybe
}

enum NotificationChannel {
  email
  push
}

enum NotificationType {
  publish
  update
  reminder
  cancel
}

enum NotificationStatus {
  queued
  sent
  failed
  skipped
}

enum RecurrenceFrequency {
  none
  daily
  weekly
  monthly
}

enum UniformOfDay {
  PT
  ABU_OCP
  BLUES
}

model Tenant {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  orgid            Int
  unitOnly         Boolean    @default(true)
  timezone         String
  syncScheduleCron String
  credentialsRef   String
  fileMappingJson  Json?
  isEnabled        Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  users            TenantUser[]
  members          Member[]
  memberContacts   MemberContact[]
  memberAddresses  MemberAddress[]
  dutyPositions    DutyPosition[]
  cadetPromotions  CadetPromotion[]
  syncRuns         SyncRun[]
  events           Event[]
  eventAudienceRules EventAudienceRule[]
  eventRsvps       EventRsvp[]
  eventNotifications EventNotification[]
  pushSubscriptions PushSubscription[]
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  systemRole   SystemRole  @default(user)
  createdAt    DateTime    @default(now())
  tenants      TenantUser[]
  refreshTokens RefreshToken[]
  createdEvents Event[]      @relation("EventCreatedBy")
  updatedEvents Event[]      @relation("EventUpdatedBy")
  eventRsvps    EventRsvp[]
  pushSubscriptions PushSubscription[]
}

model TenantUser {
  tenantId String
  userId   String
  role     TenantRole
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
}

model SyncRun {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  finishedAt      DateTime?
  status          SyncRunStatus
  membersUpserted Int          @default(0)
  membersActive   Int          @default(0)
  errorMessage    String?
  fileListJson    Json?
  checksum        String?
  createdAt       DateTime     @default(now())
}

model Member {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid          String
  firstName      String
  lastName       String
  grade          String?
  memberType     MemberType   @default(UNKNOWN)
  email          String?
  status         MemberStatus @default(UNKNOWN)
  unitCharter    String?
  orgid          Int?
  expirationDate DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, capid])
  @@index([tenantId, lastName])
}

model MemberContact {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid        String
  type         String
  priority     String?
  contact      String
  doNotContact Boolean  @default(false)
  contactName  String?
  updatedAt    DateTime @updatedAt

  @@index([tenantId, capid])
  @@index([tenantId, type])
}

model MemberAddress {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid     String
  type      String
  priority  String?
  addr1     String?
  addr2     String?
  city      String?
  state     String?
  zip       String?
  latitude  String?
  longitude String?
  updatedAt DateTime @updatedAt

  @@index([tenantId, capid])
  @@index([tenantId, type])
}

model DutyPosition {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid     String
  dutyName  String
  dutyCode  String?
  startDate DateTime?
  endDate   DateTime?
  updatedAt DateTime @updatedAt

  @@index([tenantId, capid])
  @@index([tenantId, dutyCode])
}

model CadetPromotion {
  id                         String   @id @default(cuid())
  tenantId                   String
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid                      String
  memberName                 String?
  rank                       String?
  achievementName            String?
  achievementCode            Int?
  datePromotionEligible      DateTime?
  lastPtDate                 DateTime?
  ptDate                     DateTime?
  leadershipTestDate         DateTime?
  leadershipModuleDate       DateTime?
  aeTestDate                 DateTime?
  aeModuleDate               DateTime?
  drillDate                  DateTime?
  moralForumDate             DateTime?
  welcomeCourseDate          DateTime?
  staffServiceDate           DateTime?
  oralPresentationDate       DateTime?
  leadershipTestNotRequired  Boolean  @default(false)
  leadershipModuleNotRequired Boolean @default(false)
  aeTestNotRequired          Boolean  @default(false)
  aeModuleNotRequired        Boolean  @default(false)
  drillNotRequired           Boolean  @default(false)
  requiresCD                 Boolean  @default(true)
  requiresSDA                Boolean  @default(true)
  isFirstAchievement         Boolean  @default(false)
  inactive                   Boolean  @default(false)
  ready                      Boolean  @default(false)
  readyStatus                String?
  leadershipTestCompleted    Boolean  @default(false)
  leadershipModuleCompleted  Boolean  @default(false)
  aeTestCompleted            Boolean?
  aeModuleCompleted          Boolean?
  chiefSpeechEssayCompleted  Boolean  @default(false)
  sdaCompleted               Boolean  @default(false)
  ptStatus                   String?
  leadStatus                 String?
  aeStatus                   String?
  drillStatus                String?
  cdStatus                   String?
  sdaStatus                  String?
  comments                   String?
  sourceRow                  Int?
  updatedAt                  DateTime @updatedAt

  @@unique([tenantId, capid])
  @@index([tenantId, ready])
  @@index([tenantId, inactive])
}

model Event {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  location        String?
  uniformOfDay    UniformOfDay?
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean         @default(false)
  visibility      EventVisibility @default(tenant)
  createdByUserId String
  createdBy       User            @relation("EventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUserId String?
  updatedBy       User?           @relation("EventUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  isCancelled     Boolean         @default(false)
  cancelReason    String?
  recurrenceSeriesId String?
  recurrenceFrequency RecurrenceFrequency @default(none)
  recurrenceInterval Int          @default(1)
  recurrenceUntil  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  audienceRules   EventAudienceRule[]
  rsvps           EventRsvp[]
  notifications   EventNotification[]

  @@index([tenantId, startsAt])
  @@index([tenantId, isCancelled, startsAt])
  @@index([tenantId, recurrenceSeriesId])
}

model EventAudienceRule {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberType  MemberType?
  unitCharter String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, eventId])
}

model EventRsvp {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  capid       String?
  status      RsvpStatus
  note        String?
  source      String     @default("web")
  respondedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, eventId, userId])
  @@index([tenantId, eventId, status])
  @@index([tenantId, capid])
}

model EventNotification {
  id           String              @id @default(cuid())
  tenantId     String
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  channel      NotificationChannel
  type         NotificationType
  scheduledAt  DateTime
  sentAt       DateTime?
  status       NotificationStatus  @default(queued)
  errorMessage String?
  payloadJson  Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, eventId, channel, type])
}

model PushSubscription {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  expiresAt  DateTime?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([tenantId, userId, endpoint])
  @@index([tenantId, userId])
}

model RefreshToken {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String       @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  replacedBy        RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id])
  replaces          RefreshToken[] @relation("RefreshTokenReplacement")
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}
