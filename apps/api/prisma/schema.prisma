generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  systemAdmin
  user
}

enum TenantRole {
  tenantAdmin
  tenantViewer
}

enum SyncRunStatus {
  success
  failed
  running
}

enum MemberType {
  CADET
  SENIOR
  UNKNOWN
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

model Tenant {
  id               String     @id @default(cuid())
  name             String
  slug             String     @unique
  orgid            Int
  unitOnly         Boolean    @default(true)
  timezone         String
  syncScheduleCron String
  credentialsRef   String
  fileMappingJson  Json?
  isEnabled        Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  users            TenantUser[]
  members          Member[]
  memberContacts   MemberContact[]
  memberAddresses  MemberAddress[]
  dutyPositions    DutyPosition[]
  cadetPromotions  CadetPromotion[]
  syncRuns         SyncRun[]
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  systemRole   SystemRole  @default(user)
  createdAt    DateTime    @default(now())
  tenants      TenantUser[]
  refreshTokens RefreshToken[]
}

model TenantUser {
  tenantId String
  userId   String
  role     TenantRole
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
}

model SyncRun {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  finishedAt      DateTime?
  status          SyncRunStatus
  membersUpserted Int          @default(0)
  membersActive   Int          @default(0)
  errorMessage    String?
  fileListJson    Json?
  checksum        String?
  createdAt       DateTime     @default(now())
}

model Member {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid          String
  firstName      String
  lastName       String
  grade          String?
  memberType     MemberType   @default(UNKNOWN)
  email          String?
  status         MemberStatus @default(UNKNOWN)
  unitCharter    String?
  orgid          Int?
  expirationDate DateTime?
  updatedAt      DateTime     @updatedAt

  @@unique([tenantId, capid])
  @@index([tenantId, lastName])
}

model MemberContact {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid        String
  type         String
  priority     String?
  contact      String
  doNotContact Boolean  @default(false)
  contactName  String?
  updatedAt    DateTime @updatedAt

  @@index([tenantId, capid])
  @@index([tenantId, type])
}

model MemberAddress {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid     String
  type      String
  priority  String?
  addr1     String?
  addr2     String?
  city      String?
  state     String?
  zip       String?
  latitude  String?
  longitude String?
  updatedAt DateTime @updatedAt

  @@index([tenantId, capid])
  @@index([tenantId, type])
}

model DutyPosition {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid     String
  dutyName  String
  dutyCode  String?
  startDate DateTime?
  endDate   DateTime?
  updatedAt DateTime @updatedAt

  @@index([tenantId, capid])
  @@index([tenantId, dutyCode])
}

model CadetPromotion {
  id                         String   @id @default(cuid())
  tenantId                   String
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  capid                      String
  memberName                 String?
  rank                       String?
  achievementName            String?
  achievementCode            Int?
  datePromotionEligible      DateTime?
  lastPtDate                 DateTime?
  ptDate                     DateTime?
  leadershipTestDate         DateTime?
  leadershipModuleDate       DateTime?
  aeTestDate                 DateTime?
  aeModuleDate               DateTime?
  drillDate                  DateTime?
  moralForumDate             DateTime?
  welcomeCourseDate          DateTime?
  staffServiceDate           DateTime?
  oralPresentationDate       DateTime?
  leadershipTestNotRequired  Boolean  @default(false)
  leadershipModuleNotRequired Boolean @default(false)
  aeTestNotRequired          Boolean  @default(false)
  aeModuleNotRequired        Boolean  @default(false)
  drillNotRequired           Boolean  @default(false)
  requiresCD                 Boolean  @default(true)
  requiresSDA                Boolean  @default(true)
  isFirstAchievement         Boolean  @default(false)
  inactive                   Boolean  @default(false)
  ready                      Boolean  @default(false)
  readyStatus                String?
  leadershipTestCompleted    Boolean  @default(false)
  leadershipModuleCompleted  Boolean  @default(false)
  aeTestCompleted            Boolean?
  aeModuleCompleted          Boolean?
  chiefSpeechEssayCompleted  Boolean  @default(false)
  sdaCompleted               Boolean  @default(false)
  ptStatus                   String?
  leadStatus                 String?
  aeStatus                   String?
  drillStatus                String?
  cdStatus                   String?
  sdaStatus                  String?
  comments                   String?
  sourceRow                  Int?
  updatedAt                  DateTime @updatedAt

  @@unique([tenantId, capid])
  @@index([tenantId, ready])
  @@index([tenantId, inactive])
}

model RefreshToken {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String       @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  replacedBy        RefreshToken? @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id])
  replaces          RefreshToken[] @relation("RefreshTokenReplacement")
  createdAt         DateTime     @default(now())

  @@index([userId])
  @@index([expiresAt])
}
