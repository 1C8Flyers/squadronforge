# Shared
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://postgres:postgres@db:5432/squadronforge

# First-run admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Example tenant CAPWATCH credentials (slug: rockford)
CAPWATCH_ROCKFORD_CAPID=123456
CAPWATCH_ROCKFORD_PASSWORD=super-secret

# Optional Docker secret file paths (preferred in containers)
# CAPWATCH_ROCKFORD_CAPID_FILE=/run/secrets/capwatch_rockford_capid
# CAPWATCH_ROCKFORD_PASSWORD_FILE=/run/secrets/capwatch_rockford_password
