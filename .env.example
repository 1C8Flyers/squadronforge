# Shared
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-refresh
API_HOST_PORT=4000
WEB_HOST_PORT=5173
VITE_API_URL=http://localhost:4000
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://postgres:postgres@db:5432/squadronforge

# First-run admin seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# CAPWATCH per-tenant credentials (replace ACME with tenant credentialsRef uppercased)
# CAPWATCH_ACME_CAPID=123456
# CAPWATCH_ACME_PASSWORD=super-secret

# Optional Docker secret file paths (preferred in containers)
# CAPWATCH_ACME_CAPID_FILE=/run/secrets/acme_capid.txt
# CAPWATCH_ACME_PASSWORD_FILE=/run/secrets/acme_password.txt

# Notification delivery
# RSVP_LINK_SECRET=change-me-rsvp-secret
# RSVP_LINK_BASE_URL=http://localhost:4000

# SMTP (email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<username>
# SMTP_PASS=<password>
# EMAIL_FROM=SquadronForge <no-reply@example.com>

# Web Push (VAPID)
# VAPID_PUBLIC_KEY=<publicKey>
# VAPID_PRIVATE_KEY=<privateKey>
# VAPID_SUBJECT=mailto:admin@example.com
